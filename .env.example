# ─────────────────────────────────────────────────────────────────────────────
#  Copia este archivo a  .env.local  y rellena los valores.
#  .env.local está en .gitignore: NUNCA se sube a GitHub.
#  Ninguna variable lleva el prefijo NEXT_PUBLIC_ — todas son de servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon: cadena AGRUPADA (pooler). La usa la aplicación en runtime.
#    Lleva "-pooler" en el host. Es la que se usa el 99 % del tiempo.
DATABASE_URL=postgresql://neondb_owner:npg_HrwQOzIgV86c@ep-round-breeze-a2ry6grp-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Neon: cadena DIRECTA (sin pooler). Solo para migraciones y scripts.
#    Es la misma pero SIN "-pooler" en el host.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_HrwQOzIgV86c@ep-round-breeze-a2ry6grp.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Panel de administración (/panel)
#    Genera las tres de una vez con:  npm run panel:clave
AUTH_SECRET=""
ADMIN_USUARIO=""
ADMIN_CLAVE_HASH=""

